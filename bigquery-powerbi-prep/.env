# Configuration BigQuery Analytics - Course Green Dataset

# Google Cloud Configuration
PROJECT_ID=versatile-vine-462408-g0
DATASET_ID=Course_green
TABLE_ID=green_categories

# Méthode d'authentification
# Utiliser le fichier de service account JSON existant
GOOGLE_APPLICATION_CREDENTIALS=/var/www/production-workspace/versatile-vine-462408-g0-5b7227358999.json

# Option 2: Utiliser les variables d'environnement directement (plus sécurisé)
# GOOGLE_CLOUD_PROJECT=votre-project-id
# GOOGLE_CLOUD_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Configuration Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-bigquery-analytics

# Configuration analyse
DEFAULT_LIMIT=1000
CACHE_TIMEOUT=300
