    <!-- JavaScript Essential -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="/js/ecommerce-dashboard.js"></script>
    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Dashboard data for modal navigation
        const dashboardData = [
            {
                title: "📈 Synthèse Financière",
                image: "/assets/images/dashboard_bnp1.png",
                description: "Vue d'ensemble des performances BNP Paribas"
            },
            {
                title: "🛡️ Risques & Réglementation", 
                image: "/assets/images/dashboard_bnp3.png",
                description: "Analyse prudentielle et conformité"
            },
            {
                title: "🏢 Performance Divisions",
                image: "/assets/images/dashboard_pnb2.png", 
                description: "Domestic Markets, IFS, CIB"
            },
            {
                title: "🔗 Model View / Power BI",
                image: "/assets/images/dashboard_pnb4.png", 
                description: "Architecture et relations du modèle de données"
            }
        ];

        let currentModalIndex = 0;

        // Modal functions
        function openModal(index) {
            currentModalIndex = index;
            const modal = document.getElementById('screenshotModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalImage = document.getElementById('modalImage');
            const modalCounter = document.getElementById('modalCounter');
            
            modal.style.display = 'flex';
            modalTitle.textContent = dashboardData[index].title;
            modalImage.src = dashboardData[index].image;
            modalImage.alt = dashboardData[index].description;
            modalCounter.textContent = `${index + 1} / ${dashboardData.length}`;
            
            document.body.style.overflow = 'hidden';
        }

        function closeModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const modal = document.getElementById('screenshotModal');
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function nextImage() {
            currentModalIndex = (currentModalIndex + 1) % dashboardData.length;
            openModal(currentModalIndex);
        }

        function prevImage() {
            currentModalIndex = currentModalIndex === 0 ? dashboardData.length - 1 : currentModalIndex - 1;
            openModal(currentModalIndex);
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('screenshotModal');
            if (modal.style.display === 'flex') {
                if (e.key === 'Escape') closeModal();
                if (e.key === 'ArrowLeft') prevImage();
                if (e.key === 'ArrowRight') nextImage();
            }
        });

        // Counter animations
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                const pnbElement = document.getElementById('pnb-counter');
                const resultatElement = document.getElementById('resultat-counter');
                const roeElement = document.getElementById('roe-counter');
                const cet1Element = document.getElementById('cet1-counter');

                if (pnbElement) pnbElement.textContent = '44.0 Md€';
                if (resultatElement) resultatElement.textContent = '11.7 Md€';
                if (roeElement) roeElement.textContent = '10.0%';
                if (cet1Element) cet1Element.textContent = '13.0%';
            }, 500);
        });
    </script>
</body>

</html>